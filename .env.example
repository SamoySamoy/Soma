# Copy to .env for local development. Never commit .env.

SOMA_MODE=local
SOMA_BASE_URL=http://localhost:8080
SOMA_HTTP_ADDR=127.0.0.1:8080

# Application role: subject to row-level security.
SOMA_DATABASE_URL=postgres://soma_app:soma_app_dev@localhost:5432/soma?sslmode=disable
# Schema owner: used only for migrations.
SOMA_MIGRATE_DATABASE_URL=postgres://soma:soma_dev@localhost:5432/soma?sslmode=disable
SOMA_AUTO_MIGRATE=true

SOMA_LOG_LEVEL=debug
SOMA_LOG_FORMAT=text
